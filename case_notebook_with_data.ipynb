    "    \"        blue_upsampled = upsample_time_series(b_cc_ts)\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        red_upsampled = r_cc_ts #Non upsampled version\\n\",\n",
    "    \"        green_upsampled = g_cc_ts #Non upsampled version\\n\",\n",
    "    \"        blue_upsampled = b_cc_ts #Non upsampled version\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 2. Compute recurrence plot for each channel\\n\",\n",
    "    \"    red_rp = compute_recurrence_plot(red_upsampled)\\n\",\n",
    "    \"    green_rp = compute_recurrence_plot(green_upsampled)\\n\",\n",
    "    \"    blue_rp = compute_recurrence_plot(blue_upsampled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 3. Normalize each RP to [0, 255]\\n\",\n",
    "    \"    red_rpn = ((red_rp - red_rp.min()) /(red_rp.max() - red_rp.min()) * 255)\\n\",\n",
    "    \"    green_rpn = ((green_rp - green_rp.min()) /(green_rp.max() - green_rp.min()) * 255)\\n\",\n",
    "    \"    blue_rpn = ((blue_rp - blue_rp.min()) /(blue_rp.max() - blue_rp.min()) * 255)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 4. Stack into an RGB image\\n\",\n",
    "    \"    RGB_image = np.zeros((140, 140, 3), dtype= 'uint8')\\n\",\n",
    "    \"    RGB_image[:, :, 0], RGB_image[:, :, 1], RGB_image[:, :, 2] = red_rpn, green_rpn, blue_rpn\\n\",\n",
    "    \"    return RGB_image\"\n",
    "   ]\n",
