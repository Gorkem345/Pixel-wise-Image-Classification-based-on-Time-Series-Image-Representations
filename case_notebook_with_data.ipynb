    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"def upsample_time_series(ts, original_length=37, target_length=140):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Upsample a time series using linear interpolation.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    ts : np.ndarray\\n\",\n",
    "    \"        Original time series of shape (original_length,).\\n\",\n",
    "    \"    original_length : int\\n\",\n",
    "    \"        Number of original time steps.\\n\",\n",
    "    \"    target_length : int\\n\",\n",
    "    \"        Number of target time steps after upsampling.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    ts_upsampled : np.ndarray\\n\",\n",
    "    \"        Upsampled time series of shape (target_length,).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # TODO: Implement linear interpolation upsampling\\n\",\n",
    "    \"    # Hint: use scipy.interpolate.interp1d\\n\",\n",
    "    \"\\n\",\n",
    "    \"    x = np.linspace(0, 1, original_length)\\n\",\n",
    "    \"    x_new = np.linspace(0, 1, num = target_length)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    f = interp1d(x, ts, kind='linear')\\n\",\n",
    "    \"    ts_upsampled = f(x_new)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return ts_upsampled\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"def compute_recurrence_plot(ts):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Compute the gray-level recurrence plot (distance matrix) for a time series.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    ts : np.ndarray\\n\",\n",
    "    \"        Time series of shape (N,).\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    rp : np.ndarray\\n\",\n",
    "    \"        Recurrence plot (distance matrix) of shape (N, N).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # TODO: Compute the pairwise Euclidean distance matrix\\n\",\n",
    "    \"    # R_{i,j} = ||x_i - x_j||\\n\",\n",
