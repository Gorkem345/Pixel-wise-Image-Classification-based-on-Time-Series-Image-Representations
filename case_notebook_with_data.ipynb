    "    \"        # Calculates the means in C level, so it is a lot faster than a manual loop\\n\",\n",
    "    \"        r_px_ts[t] = image[h,w,0]\\n\",\n",
    "    \"        g_px_ts[t] = image[h,w,1]\\n\",\n",
