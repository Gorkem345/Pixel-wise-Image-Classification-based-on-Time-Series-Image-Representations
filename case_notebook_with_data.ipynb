    "    \"# For each ROI, extract the time series of r_cc, g_cc, b_cc values\\n\",\n",
    "    \"chromatic_stack = np.zeros((NUM_OF_IMGS, IMG_H, IMG_W, 3), dtype=np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for t, img in enumerate(images):\\n\",\n",
