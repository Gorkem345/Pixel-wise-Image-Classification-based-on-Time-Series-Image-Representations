    "   \"source\": [\n",
    "    \"def extract_pixel_time_series(my_images, h, w):\\n\",\n",
    "    \"    # np arrays with 1D shape\\n\",\n",
    "    \"    r_px_ts = np.zeros((NUM_OF_IMGS,), dtype=np.float32)\\n\",\n",
