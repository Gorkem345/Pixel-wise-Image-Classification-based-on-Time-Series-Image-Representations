    "    \"\\n\",\n",
    "    \"    ts_reshaped = ts.reshape(len(ts), 1)\\n\",\n",
    "    \"    return cdist(ts_reshaped, ts_reshaped, 'euclidean')\\n\"\n",
    "   ]\n",
