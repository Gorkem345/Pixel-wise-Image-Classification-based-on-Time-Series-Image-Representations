    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"def create_rgb_recurrence_plot(r_cc_ts, g_cc_ts, b_cc_ts, upsample=True):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Create an RGB recurrence plot image by combining the recurrence plots\\n\",\n",
    "    \"    of the three chromatic coordinate channels.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    r_cc_ts : np.ndarray\\n\",\n",
    "    \"        Red chromatic coordinate time series, shape (N,).\\n\",\n",
    "    \"    g_cc_ts : np.ndarray\\n\",\n",
    "    \"        Green chromatic coordinate time series, shape (N,).\\n\",\n",
    "    \"    b_cc_ts : np.ndarray\\n\",\n",
    "    \"        Blue chromatic coordinate time series, shape (N,).\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    rgb_rp : np.ndarray\\n\",\n",
    "    \"        RGB recurrence plot image of shape (N, N, 3).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # TODO: Implement the following steps:\\n\",\n",
    "    \"    if upsample:\\n\",\n",
    "    \"    # 1. Upsample each time series\\n\",\n",
    "    \"        red_upsampled = upsample_time_series(r_cc_ts)\\n\",\n",
