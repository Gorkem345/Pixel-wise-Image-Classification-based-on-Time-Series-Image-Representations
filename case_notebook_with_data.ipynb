    "    \"\\n\",\n",
    "    \"    return r_px_ts, g_px_ts, b_px_ts\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def extract_roi_time_series(my_images, mask):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Extract the mean chromatic coordinate time series for a given ROI.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters\\n\",\n",
