    "    \"\\n\",\n",
    "    \"    print(\\\"Finished a mask\\\")\\n\",\n",
    "    \"    return r_cc_ts, g_cc_ts, b_cc_ts\\n\",\n",
    "    \"\\n\",\n",
    "    \"'''\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# TODO: Extract time series for all ROIs and store with their labels\\n\",\n",
    "    \"number_of_masks = len(all_masks)\\n\",\n",
    "    \"labels = [] # list of corresponding species labels\\n\",\n",
    "    \"time_series_data = np.zeros((number_of_masks, NUM_OF_IMGS, 3), dtype=np.float32)  # list of (r_cc_ts, g_cc_ts, b_cc_ts) tuples\\n\",\n",
    "    \"for i, mask in enumerate(all_masks):\\n\",\n",
    "    \"    time_series_data[i,:, 0], time_series_data[i, :, 1], time_series_data[i, :, 2] = extract_roi_time_series(chromatic_stack, mask)\\n\",\n",
    "    \"    labels.append(all_masks[i][\\\"species_name\\\"])\\n\",\n",
