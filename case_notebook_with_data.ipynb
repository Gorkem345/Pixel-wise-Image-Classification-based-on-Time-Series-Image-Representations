    "    \"    mask : np.ndarray\\n\",\n",
    "    \"        Binary mask of shape (H, W) defining the ROI.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    r_cc_ts : np.ndarray\\n\",\n",
    "    \"        Time series of mean r_cc values, shape (T,).\\n\",\n",
    "    \"    g_cc_ts : np.ndarray\\n\",\n",
    "    \"        Time series of mean g_cc values, shape (T,).\\n\",\n",
    "    \"    b_cc_ts : np.ndarray\\n\",\n",
    "    \"        Time series of mean b_cc values, shape (T,).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # TODO: Implement time series extraction\\n\",\n",
    "    \"    # np arrays with 1D shape\\n\",\n",
    "    \"    r_cc_ts = np.zeros((NUM_OF_IMGS,), dtype=np.float32)\\n\",\n",
    "    \"    g_cc_ts = np.zeros((NUM_OF_IMGS,), dtype=np.float32)\\n\",\n",
    "    \"    b_cc_ts = np.zeros((NUM_OF_IMGS,), dtype=np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for t, image in enumerate(my_images):\\n\",\n",
    "    \"        r_cc_ts[t] = np.mean(image[:,:,0][mask[\\\"mask\\\"]])\\n\",\n",
    "    \"        g_cc_ts[t] = np.mean(image[:,:,1][mask[\\\"mask\\\"]])\\n\",\n",
    "    \"        b_cc_ts[t] = np.mean(image[:,:,2][mask[\\\"mask\\\"]])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    #print(\\\"Finished a mask\\\")\\n\",\n",
    "    \"    return r_cc_ts, g_cc_ts, b_cc_ts\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"'''\\n\",\n",
    "    \"Enumerated for loop to keep the indices of the images, works way SLOWER so WE DO NOT USE THIS!!!\\n\",\n",
    "    \"    for t, image in enumerate(my_images):\\n\",\n",
    "    \"        # Reset all the values for each image before entering the loop\\n\",\n",
    "    \"        total_red_value = 0\\n\",\n",
    "    \"        total_green_value = 0\\n\",\n",
    "    \"        total_blue_value = 0\\n\",\n",
    "    \"        total_pixels = 0\\n\",\n",
    "    \"        for h in range(IMG_H):\\n\",\n",
    "    \"            for w in range(IMG_W):\\n\",\n",
    "    \"                # Calculate the mean where mask = 1\\n\",\n",
    "    \"                if mask[\\\"mask\\\"][h,w]:\\n\",\n",
    "    \"                    total_red_value += image[h,w,0]\\n\",\n",
    "    \"                    total_green_value += image[h,w,1]\\n\",\n",
    "    \"                    total_blue_value += image[h,w,2]\\n\",\n",
    "    \"                    total_pixels += 1\\n\",\n",
    "    \"        #Calculate the means and write into the time series\\n\",\n",
    "    \"        mean_red_value = total_red_value / total_pixels\\n\",\n",
    "    \"        mean_green_value = total_green_value / total_pixels\\n\",\n",
    "    \"        mean_blue_value = total_blue_value / total_pixels\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"        r_cc_ts[t] = mean_red_value\\n\",\n",
    "    \"        g_cc_ts[t] = mean_green_value\\n\",\n",
    "    \"        b_cc_ts[t] = mean_blue_value\\n\",\n",
    "    \"\\n\",\n",
