    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"def compute_chromatic_coordinates(image):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Compute the RGB chromatic coordinates for a given image.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    image : np.ndarray\\n\",\n",
    "    \"        Input image of shape (H, W, 3) with R, G, B channels.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    r_cc : np.ndarray\\n\",\n",
    "    \"        Red chromatic coordinate, shape (H, W).\\n\",\n",
    "    \"    g_cc : np.ndarray\\n\",\n",
    "    \"        Green chromatic coordinate, shape (H, W).\\n\",\n",
    "    \"    b_cc : np.ndarray\\n\",\n",
    "    \"        Blue chromatic coordinate, shape (H, W).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # TODO: Implement chromatic coordinate computation\\n\",\n",
    "    \"    # r_cc = R / (R + G + B)\\n\",\n",
    "    \"    # g_cc = G / (R + G + B)\\n\",\n",
    "    \"    # b_cc = B / (R + G + B)\\n\",\n",
    "    \"    # Handle division by zero (e.g., black pixels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    R = image[:, :, 0].astype(float)\\n\",\n",
    "    \"    G = image[:, :, 1].astype(float)\\n\",\n",
    "    \"    B = image[:, :, 2].astype(float)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    total_intensity = R + G + B\\n\",\n",
    "    \"\\n\",\n",
    "    \"    safe_intensity = np.where(total_intensity == 0, 1, total_intensity)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    r_cc = R / safe_intensity\\n\",\n",
    "    \"    g_cc = G / safe_intensity\\n\",\n",
    "    \"    b_cc = B / safe_intensity\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return r_cc, g_cc, b_cc\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"#This is a function that is added, this will smooth the channels\\n\",\n",
    "    \"# To look at the difference with or without, please comment this out and change the lines with this funtion used with the instructions in the first cell of exercise 3.\\n\",\n",
    "    \"def sliding_window_smooth(ts, window_size=2):\\n\",\n",
    "    \"    T = len(ts)\\n\",\n",
    "    \"    smoothed = np.zeros(T, dtype=np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for t in range(T):\\n\",\n",
    "    \"        start = max(0, t - window_size)\\n\",\n",
    "    \"        end = min(T, t + window_size + 1)\\n\",\n",
    "    \"        smoothed[t] = np.mean(ts[start:end])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return smoothed\"\n",
    "   ]\n",
    "  },\n",
